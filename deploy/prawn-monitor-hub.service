[Unit]
Description=Prawn Monitor hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=prawn
WorkingDirectory=/opt/prawn-monitor
Environment=PYTHONPATH=/opt/prawn-monitor/src
ExecStart=/opt/prawn-monitor/.venv/bin/python -m prawn_monitor hub --config /etc/prawn-monitor/hub.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
